{{#*inline "build-scripts"}}
{{~#each this}}{{#if this.path}}
      - path {{this.path}}{{/if}}{{#if this.script}}
      - script: {{this.script}}{{/if}}{{#if this.name}}
        name: {{this.name}}{{/if}}{{#if this.input-files}}
        inputFiles: {{~#each this.input-files}}
          - {{this}}{{/each}}{{/if}}{{#if this.output-files}}
        outputFiles: {{~#each this.output-files}}
          - {{this}}{{/each}}{{/if}}{{#if this.input-file-lists}}
        inputFileLists: {{~#each this.output-files}}
          - {{this}}{{/each}}{{/if}}{{#if this.output-file-lists}}
        outputFileLists: {{~#each this.output-files}}
          - {{this}}{{/each}}{{/if}}{{#if this.shell}}
        shell: {{this.shell}}{{/if}}{{#if this.show-env-vars}}
        showEnvVars: {{this.show_env_vars}}{{/if}}{{#if this.run-only-when-installing}}
        runOnlyWhenInstalling: {{this.run-only-when-installing}}{{/if}}{{#if this.based-on-dependency-analysis}}
        basedOnDependencyAnalysis: {{this.based-on-dependency-analysis}}{{/if}}{{#if this.discovered-dependency-file}}
        discoveredDependencyFile: {{this.discovered-dependency-file}}{{/if}}
      {{~/each}}
{{/inline}}
# Based on tauri-cli 2.12.4 templates/mobile/ios/project.yml. Preserve upstream build placeholders when upgrading.
name: {{app.name}}
options:
  bundleIdPrefix: {{app.identifier}}
  deploymentTarget:
    iOS: {{apple.ios-version}}
fileGroups: [{{join file-groups}}]
configs:
  debug: debug
  release: release
settings:
  base:
    CODE_SIGN_IDENTITY[sdk=iphonesimulator*]: "-"
    CODE_SIGNING_ALLOWED[sdk=iphonesimulator*]: true
    CODE_SIGN_IDENTITY[sdk=watchsimulator*]: "-"
    CODE_SIGNING_ALLOWED[sdk=watchsimulator*]: true
settingGroups:
  app:
    base:
      PRODUCT_NAME: {{app.stylized-name}}
      PRODUCT_BUNDLE_IDENTIFIER: {{app.identifier}}
      {{#if apple.development-team}}
      DEVELOPMENT_TEAM: {{apple.development-team}}
      {{/if}}
targetTemplates:
  app:
    type: application
    sources:
      - path: Sources
    scheme:
      environmentVariables:
        RUST_BACKTRACE: full
        RUST_LOG: info
    settings:
      groups: [app]
targets:
  {{app.name}}_iOS:
    type: application
    platform: iOS
    sources:
      - path: Sources
      - path: Assets.xcassets
      - path: ../../apple/AlternateIcons.xcassets
      - path: ../../apple/Localizations
        buildPhase: resources
      # Exclude built static libs: regenerating with xcodegen after a build
      # otherwise turns the per-configuration libapp.a copies into colliding
      # resources ("Multiple commands produce …/libapp.a"). They are linked
      # via LIBRARY_SEARCH_PATHS, never bundled as resources.
      - path: Externals
        excludes: ["**/*.a"]
      - path: {{app.name}}_iOS
      - path: {{app.asset-dir}}
        buildPhase: resources
        type: folder
      {{~#each asset-catalogs}}
      - {{prefix-path this}}{{/each}}
      {{~#each ios-additional-targets}}
      - path: {{prefix-path this}}{{/each}}
      - path: LaunchScreen.storyboard
    info:
      path: {{app.name}}_iOS/Info.plist
      properties:
        LSRequiresIPhoneOS: true
        NSSupportsLiveActivities: true
        CFBundleURLTypes:
          - CFBundleURLName: app.lazysh.client
            CFBundleURLSchemes: [lazysh]
        UILaunchStoryboardName: LaunchScreen
        UIRequiredDeviceCapabilities: [arm64, metal]
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        UISupportedInterfaceOrientations~ipad:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
        CFBundleShortVersionString: {{apple.bundle-version-short}}
        CFBundleVersion: "{{apple.bundle-version}}"
        {{~#each apple.plist-pairs}}
        {{this.key}}: {{this.value}}{{/each}}
    entitlements:
      path: {{app.name}}_iOS/{{app.name}}_iOS.entitlements
    scheme:
      environmentVariables:
        RUST_BACKTRACE: full
        RUST_LOG: info
      {{~#if ios-command-line-arguments}}
      commandLineArguments:
      {{~#each ios-command-line-arguments}}
        "{{this}}": true
      {{/each}}{{~/if}}
    settings:
      base:
        ENABLE_BITCODE: false
        TARGETED_DEVICE_FAMILY: "1,2"
        ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES: LazyshAmber
        ARCHS: [{{join ios-valid-archs}}]
        VALID_ARCHS: {{~#each ios-valid-archs}} {{this}} {{/each}}
        LIBRARY_SEARCH_PATHS[arch=x86_64]: $(inherited) $(PROJECT_DIR)/Externals/x86_64/$(CONFIGURATION) $(SDKROOT)/usr/lib/swift $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(PLATFORM_NAME) $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift-5.0/$(PLATFORM_NAME)
        LIBRARY_SEARCH_PATHS[arch=arm64]: $(inherited) $(PROJECT_DIR)/Externals/arm64/$(CONFIGURATION) $(SDKROOT)/usr/lib/swift $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(PLATFORM_NAME) $(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift-5.0/$(PLATFORM_NAME)
        ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES: true
        EXCLUDED_ARCHS[sdk=iphoneos*]: x86_64
      groups: [app]
    dependencies:
      # libapp.a retains Mosh's zlib references for the final Xcode link.
      - sdk: libz.tbd
      - sdk: ActivityKit.framework
        weak: true
      - target: LazyshLiveActivity
        embed: true
      - target: LazyshWatch
        embed: true
      - target: LazyshMoshAbseilPrivacy
        embed: true
        link: false
        copy:
          destination: resources
      - target: LazyshMoshProtobufPrivacy
        embed: true
        link: false
        copy:
          destination: resources
      - framework: {{ lib-output-file-name }}
        embed: false
      {{~#each ios-libraries}}
      - framework: {{this}}
        embed: false{{/each}}{{#if ios-vendor-frameworks}}{{~#each ios-vendor-frameworks}}
      - framework: {{this}}{{/each}}{{/if}}{{#if ios-vendor-sdks}}{{~#each ios-vendor-sdks}}
      - sdk: {{prefix-path this}}{{/each}}{{/if}}
      - sdk: CoreGraphics.framework
      - sdk: Metal.framework
      - sdk: MetalKit.framework
      - sdk: QuartzCore.framework
      - sdk: Security.framework
      - sdk: UIKit.framework{{#if this.ios-frameworks}}{{~#each ios-frameworks}}
      - sdk: {{this}}.framework{{/each}}{{/if}}
      - sdk: WebKit.framework
    preBuildScripts:
{{> build-scripts ios-pre-build-scripts}}

      - script: |
          {{ shell-escape tauri-binary }} {{ tauri-binary-args-str }} -v --platform "${PLATFORM_DISPLAY_NAME:?}" --sdk-root "${SDKROOT:?}" --framework-search-paths "${FRAMEWORK_SEARCH_PATHS:?}" --header-search-paths "${HEADER_SEARCH_PATHS:?}" --gcc-preprocessor-definitions "${GCC_PREPROCESSOR_DEFINITIONS:-}" --configuration "${CONFIGURATION:?}" ${FORCE_COLOR} ${ARCHS:?}
        name: Build Rust Code
        basedOnDependencyAnalysis: false
        outputFiles:
          - $(SRCROOT)/Externals/x86_64/${CONFIGURATION}/{{ lib-output-file-name }}
          - $(SRCROOT)/Externals/arm64/${CONFIGURATION}/{{ lib-output-file-name }}
    {{~#if ios-post-compile-scripts}}
    postCompileScripts:
{{> build-scripts ios-post-compile-scripts}}
    {{~/if~}}
    {{~#if ios-post-build-scripts}}
    postBuildScripts:
{{> build-scripts ios-post-build-scripts}}
    {{~/if}}

  LazyshMoshAbseilPrivacy:
    type: bundle
    platform: iOS
    sources:
      - path: ../../../../../packages/mosh-transport/vendor-android/abseil/PrivacyInfo.xcprivacy
        buildPhase: resources
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: {{app.identifier}}.privacy.abseil
        SKIP_INSTALL: true
    info:
      path: LazyshMoshAbseilPrivacy/Info.plist
      properties:
        CFBundleShortVersionString: {{apple.bundle-version-short}}
        CFBundleVersion: "{{apple.bundle-version}}"

  LazyshMoshProtobufPrivacy:
    type: bundle
    platform: iOS
    sources:
      - path: ../../../../../packages/mosh-transport/vendor-android/protobuf/PrivacyInfo.xcprivacy
        buildPhase: resources
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: {{app.identifier}}.privacy.protobuf
        SKIP_INSTALL: true
    info:
      path: LazyshMoshProtobufPrivacy/Info.plist
      properties:
        CFBundleShortVersionString: {{apple.bundle-version-short}}
        CFBundleVersion: "{{apple.bundle-version}}"

  LazyshMoshAppTests:
    type: bundle.unit-test
    platform: iOS
    deploymentTarget: "16.0"
    sources:
      - path: ../../apple/MoshTests
      - path: ../../../../../packages/display-idle/ios/Sources/DisplayIdleState.swift
      - path: ../../../../../packages/display-idle/ios/Tests
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: {{app.identifier}}.moshapptests
        SWIFT_VERSION: "5.0"
        GENERATE_INFOPLIST_FILE: true
        # Use the verified Tauri artifact without rebuilding the app: the
        # always-run Rust phase requires Tauri's now-closed CLI options server.
        # Xcode requires the host's PlugIns folder below the test product root.
        CONFIGURATION_BUILD_DIR: "$(SRCROOT)/build/arm64-sim"
        TEST_HOST: "$(CONFIGURATION_BUILD_DIR)/{{app.stylized-name}}.app/{{app.stylized-name}}"
        BUNDLE_LOADER: "$(TEST_HOST)"
    scheme:
      buildImplicitDependencies: false
      testTargets: [LazyshMoshAppTests]
      # Keep unified logging enabled without LLDB's duplicate stderr mirror.
      environmentVariables:
        IDE_DISABLED_OS_ACTIVITY_DT_MODE: "1"

  LazyshLiveActivity:
    type: app-extension
    platform: iOS
    deploymentTarget: "16.2"
    sources:
      - path: ../../apple/LiveActivityExtension
      - path: ../../../../../packages/apple-status/ios/Shared/AgentActivityAttributes.swift
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: app.lazysh.client.liveactivity
        SKIP_INSTALL: true
        APPLICATION_EXTENSION_API_ONLY: true
        SWIFT_VERSION: "5.0"
        {{#if apple.development-team}}
        DEVELOPMENT_TEAM: {{apple.development-team}}
        {{/if}}
    info:
      path: LazyshLiveActivity/Info.plist
      properties:
        CFBundleShortVersionString: {{apple.bundle-version-short}}
        CFBundleVersion: "{{apple.bundle-version}}"
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension

  LazyshWatch:
    type: application
    platform: watchOS
    deploymentTarget: "10.0"
    sources:
      - path: ../../apple/WatchApp
      - path: ../../apple/WatchWidgets/StatusCache.swift
      - path: ../../../../../packages/apple-status/ios/Shared/StatusSnapshot.swift
    dependencies:
      - target: LazyshWatchWidgets
        embed: true
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: app.lazysh.client.watchkitapp
        SWIFT_VERSION: "5.0"
        SDKROOT: watchos
        SUPPORTED_PLATFORMS: watchos watchsimulator
        TARGETED_DEVICE_FAMILY: "4"
        {{#if apple.development-team}}
        DEVELOPMENT_TEAM: {{apple.development-team}}
        {{/if}}
    info:
      path: LazyshWatch/Info.plist
      properties:
        CFBundleShortVersionString: {{apple.bundle-version-short}}
        CFBundleVersion: "{{apple.bundle-version}}"
        WKApplication: true
        WKCompanionAppBundleIdentifier: app.lazysh.client
        WKRunsIndependentlyOfCompanionApp: false
    entitlements:
      path: LazyshWatch/LazyshWatch.entitlements
      properties:
        com.apple.security.application-groups: [group.app.lazysh.client.status]
    scheme: {}

  LazyshWatchWidgets:
    type: app-extension
    platform: watchOS
    deploymentTarget: "10.0"
    sources:
      - path: ../../apple/WatchWidgets
      - path: ../../../../../packages/apple-status/ios/Shared/StatusSnapshot.swift
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: app.lazysh.client.watchkitapp.widgets
        SDKROOT: watchos
        SUPPORTED_PLATFORMS: watchos watchsimulator
        SKIP_INSTALL: true
        APPLICATION_EXTENSION_API_ONLY: true
        SWIFT_VERSION: "5.0"
        {{#if apple.development-team}}
        DEVELOPMENT_TEAM: {{apple.development-team}}
        {{/if}}
    info:
      path: LazyshWatchWidgets/Info.plist
      properties:
        CFBundleShortVersionString: {{apple.bundle-version-short}}
        CFBundleVersion: "{{apple.bundle-version}}"
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
    entitlements:
      path: LazyshWatchWidgets/LazyshWatchWidgets.entitlements
      properties:
        com.apple.security.application-groups: [group.app.lazysh.client.status]

  LazyshStatusTests:
    type: bundle.unit-test
    platform: iOS
    deploymentTarget: "16.2"
    sources:
      - path: ../../../../../packages/apple-status/ios/Shared/StatusSnapshot.swift
      - path: ../../../../../packages/apple-status/ios/Shared/AppIconState.swift
      - path: ../../../../../packages/apple-status/ios/Tests
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: app.lazysh.client.statustests
        SWIFT_VERSION: "5.0"
        GENERATE_INFOPLIST_FILE: true
    scheme:
      testTargets: [LazyshStatusTests]

  LazyshPushTests:
    type: bundle.unit-test
    platform: iOS
    deploymentTarget: "16.2"
    sources:
      - path: ../../../../../packages/push-registration/ios/Shared/APNsRegistrationState.swift
      - path: ../../../../../packages/push-registration/ios/Tests
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: app.lazysh.client.pushtests
        SWIFT_VERSION: "5.0"
        GENERATE_INFOPLIST_FILE: true
    scheme:
      testTargets: [LazyshPushTests]

  LazyshResumeTests:
    type: bundle.unit-test
    platform: iOS
    deploymentTarget: "16.2"
    sources:
      - path: ../../../../../packages/credential-vault/ios/Sources/ResumeGate.swift
      - path: ../../../../../packages/credential-vault/ios/Sources/ResumeCover.swift
      - path: ../../../../../packages/credential-vault/ios/Tests
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: app.lazysh.client.resumetests
        SWIFT_VERSION: "5.0"
        GENERATE_INFOPLIST_FILE: true
    scheme:
      testTargets: [LazyshResumeTests]

  # Standalone UI runner exercises the already built/installed production app.
  # No app dependency: the app's Rust phase requires a live Tauri CLI server.
  LazyshWorkspaceUITests:
    type: bundle.ui-testing
    platform: iOS
    deploymentTarget: "16.2"
    sources:
      - path: ../../apple/UITests
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: app.lazysh.client.workspaceuitests
        SWIFT_VERSION: "5.0"
        GENERATE_INFOPLIST_FILE: true
        TEST_TARGET_NAME: ""
        TEST_HOST: ""
        BUNDLE_LOADER: ""
    scheme:
      testTargets: [LazyshWorkspaceUITests]
