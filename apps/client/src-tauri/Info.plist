<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Unlock saved SSH credentials with Face ID when you enable biometric protection.</string>
