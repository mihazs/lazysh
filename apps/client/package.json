{
  "name": "@lazysh/client",
  "version": "1.60.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:terminal": "playwright test -c playwright.bench.config.ts",
    "bench:agent-view": "playwright test -c playwright.bench-agent.config.ts",
    "test:published-native-gui": "vitest run --config vitest.published-native.config.ts",
    "tauri": "tauri",
    "check": "tsc -b",
    "mobile-e2e": "wdio run mobile-e2e/wdio.android.conf.ts",
    "mobile-e2e:setup": "bun mobile-e2e/support/setup.ts",
    "mobile-e2e:unit": "bun test ./mobile-e2e/support",
    "mobile-e2e:check": "tsc --noEmit -p mobile-e2e/tsconfig.json && tsc --noEmit -p mobile-e2e/tsconfig.unit.json",
    "mobile-e2e:lint": "eslint --max-warnings 0 -c mobile-e2e/eslint.config.mjs mobile-e2e"
  },
  "dependencies": {
    "@lazysh/account-usage": "workspace:*",
    "@lazysh/display-idle": "workspace:*",
    "@lazysh/common": "workspace:*",
    "@lazysh/et-transport": "workspace:*",
    "@lazysh/mosh-transport": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "5.5.0",
    "i18next": "26.5.11",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "17.1.9",
    "react-markdown": "^10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0"
  },
  "devDependencies": {
    "@lazysh/apple-speech": "workspace:*",
    "@lazysh/apple-status": "workspace:*",
    "@lazysh/credential-vault": "workspace:*",
    "@lazysh/push-registration": "workspace:*",
    "@playwright/test": "^1.55.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.14",
    "@types/mocha": "10.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@wdio/appium-service": "10.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/junit-reporter": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/types": "10.1.0",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.3",
    "eslint": "10.14.0",
    "eslint-plugin-wdio": "10.1.0",
    "globals": "17.14.0",
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/headless": "5.5.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.72.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5",
    "webdriverio": "10.1.0"
  },
  "license": "GPL-3.0-or-later"
}
