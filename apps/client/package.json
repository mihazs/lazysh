{
  "name": "@lazysh/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "dev:native": "tauri dev",
    "build:native": "tauri build --no-bundle",
    "build:android": "CMAKE_ANDROID_NDK=$NDK_HOME WHISPER_DONT_GENERATE_BINDINGS=1 tauri android build --target aarch64 --debug --apk --ci",
    "build:android:emulator": "CMAKE_ANDROID_NDK=$NDK_HOME WHISPER_DONT_GENERATE_BINDINGS=1 tauri android build --target x86_64 --debug --apk --ci",
    "test:android": "src-tauri/gen/android/gradlew -p src-tauri/gen/android :app:connectedUniversalDebugAndroidTest -PabiList=x86_64 -ParchList=x86_64 -PtargetList=x86_64 -x :app:rustBuildX86_64Debug",
    "build:ios": "cd src-tauri && tauri ios build --target aarch64-sim --debug --no-sign --ci",
    "check": "tsc -b",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:openssh": "cargo test --manifest-path src-tauri/Cargo.toml --locked openssh_sftp_and_command_interoperability -- --ignored",
    "test:local": "cargo test --manifest-path src-tauri/Cargo.toml --locked local:: -- --nocapture",
    "test:mosh": "cargo test --manifest-path src-tauri/Cargo.toml --locked openssh_mosh_bootstrap_and_control_interoperability -- --ignored",
    "test:et": "cargo test --manifest-path src-tauri/Cargo.toml --locked openssh_et_bootstrap_and_control_interoperability -- --ignored",
    "test:multiplexers": "cargo test --manifest-path src-tauri/Cargo.toml --locked ::tests::real_ -- --ignored",
    "test:voice": "cargo test --manifest-path src-tauri/Cargo.toml --locked local_whisper_ -- --ignored",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "init:ios": "cd src-tauri && tauri ios init --ci",
    "test:install-browser": "playwright install chromium",
    "test:ios-workspace": "xcodebuild -project src-tauri/gen/apple/lazysh.xcodeproj -scheme LazyshWorkspaceUITests -configuration debug -destination \"platform=iOS Simulator,id=$APPLE_STATUS_SIMULATOR_ID\" -parallel-testing-enabled NO -resultBundlePath src-tauri/gen/apple/workspace-ui.xcresult test CODE_SIGNING_ALLOWED=NO"
  },
  "dependencies": {
    "@lazysh/et-transport": "workspace:*",
    "@lazysh/mosh-transport": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@lazysh/credential-vault": "workspace:*",
    "@lazysh/apple-speech": "workspace:*",
    "@playwright/test": "^1.55.1",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5",
    "@lazysh/apple-status": "workspace:*",
    "@lazysh/push-registration": "workspace:*"
  },
  "license": "GPL-3.0-or-later"
}
