{
  "name": "@lazysh/agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cargo build --release --locked --package lazysh-agent",
    "check": "cargo check --locked --package lazysh-agent",
    "test": "cargo test --locked --package lazysh-agent",
    "lint": "cargo clippy --locked --package lazysh-agent --all-targets -- -D warnings",
    "format:check": "cargo fmt --manifest-path Cargo.toml -- --check"
  }
}
