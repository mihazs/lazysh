{
  "name": "lazysh",
  "version": "1.63.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "changeset": "bun ./node_modules/@changesets/cli/bin.js",
    "release:check": "bun test ./tests/release-consistency.test.ts",
    "release:prepare": "bun run release:version && bun run duplicates:check",
    "release:version": "bun run release:check && bun run changeset version && LAZYSH_RELEASE_VERSION=$(bun -p \"require('./apps/client/package.json').version\") && bun pm version \"$LAZYSH_RELEASE_VERSION\" --no-git-tag-version && bun .changeset/bun-lock.ts && bun run release:check",
    "test:release": "bun test ./tests/release-consistency.test.ts ./tests/release-version.test.ts ./tests/release-tag.test.ts ./tests/release-artifacts.test.ts ./tests/release-apple.test.ts ./tests/release-companion.test.ts ./tests/release-workflow.test.ts",
    "test:fdroid": "bun test ./tests/fdroid-recipe.test.ts",
    "hooks:install": "sh .githooks/pre-commit --install",
    "duplicates:check": "jscpd --config .jscpd.json --threshold 0 --fail-on-empty .",
    "duplicates:staged": "lint-staged --hide-all --config lint-staged.config.mjs",
    "test:hooks": "bun test ./tests/pre-commit.test.ts ./tests/commit-msg.test.ts ./tests/native-changes.test.ts",
    "test:ci": "bun test --timeout 60000 ./tests/android-published.test.ts ./tests/android-published-assets.test.ts ./tests/android-diagnostics.test.ts ./tests/ios-workspace-metadata.test.ts ./tests/android-ssh.test.ts ./tests/android-ssh-parity.test.ts ./tests/android-herdr-navigation.test.ts ./tests/android-tmux.test.ts ./tests/android-qr.test.ts ./tests/android-qr-ownership.test.ts ./tests/android-qr-frame.test.ts ./tests/android-ntfy.test.ts ./tests/android-gestures.test.ts ./tests/herdr-source.test.ts ./tests/pinned-download.test.ts ./tests/companion-bootstrap.test.ts ./tests/apt-install.test.ts ./tests/moon-graph.test.ts ./tests/main-verdict.test.ts",
    "dev": "moon run client:dev-native",
    "build": "moon run :build",
    "build:native": "moon run client:build-native",
    "build:android": "moon run client:build-android",
    "build:android:emulator": "moon run client:build-android-emulator",
    "test:android": "moon run client:test-android",
    "test:android-mosh": "moon run mosh-transport:test-android-mosh",
    "test:ios-mosh": "moon run mosh-transport:test-ios-mosh",
    "check": "moon run :check :check-rust",
    "test": "moon run :test :test-rust :test-hooks",
    "test:e2e": "moon run client:test-e2e",
    "test:native-gui": "moon run client:test-native-gui -c 1",
    "test:mobile-e2e": "moon run client:test-mobile-e2e",
    "test:mobile-e2e:ci": "moon run client:test-mobile-e2e-ci",
    "test:openssh": "moon run :test-openssh",
    "test:openssh-connections": "moon run :test-openssh-connections",
    "test:multiplexers": "moon run :test-multiplexers",
    "test:voice": "moon run :test-voice",
    "test:et": "moon run :test-et",
    "test:mosh": "moon run :test-mosh",
    "test:storage": "moon run agent:test-storage",
    "lint": "moon run :lint",
    "format:check": "moon run :format-check",
    "build:ios": "moon run client:build-ios",
    "test:install-browser": "moon run :test-install-browser",
    "test:ios-workspace": "moon run client:test-ios-workspace",
    "test:android-theme-links": "moon run client:test-android-theme-links",
    "test:android-ssh": "moon run client:test-android-ssh",
    "test:android-herdr-navigation": "moon run client:test-android-herdr-navigation",
    "test:android-tmux": "moon run client:test-android-tmux",
    "test:android-ssh-parity": "moon run client:test-android-ssh-parity",
    "build:android:fdroid": "moon run client:build-android-fdroid",
    "test:android-fdroid": "moon run client:test-android-fdroid",
    "test:android-ntfy": "moon run client:test-android-ntfy",
    "test:android-qr": "moon run client:test-android-qr",
    "test:android-gestures": "moon run client:test-android-gestures",
    "test:android-biometric": "moon run client:test-android-biometric"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@moonrepo/cli": "2.6.5",
    "jscpd": "5.4.2",
    "lint-staged": "17.6.0"
  },
  "overrides": {
    "hast-util-raw": "9.1.0"
  },
  "license": "GPL-3.0-or-later"
}
