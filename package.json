{
  "name": "lazysh",
  "version": "0.20.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "changeset": "bun ./node_modules/@changesets/cli/bin.js",
    "release:check": "bun test ./tests/release-consistency.test.ts",
    "release:prepare": "bun run release:version && bun run duplicates:check",
    "release:version": "bun run release:check && bun run changeset version && LAZYSH_RELEASE_VERSION=$(bun -p \"require('./apps/client/package.json').version\") && bun pm version \"$LAZYSH_RELEASE_VERSION\" --no-git-tag-version && cargo set-version --workspace \"$LAZYSH_RELEASE_VERSION\" && bun .changeset/bun-lock.ts && bun run release:check",
    "test:release": "bun test ./tests/release-consistency.test.ts ./tests/release-version.test.ts ./tests/release-tag.test.ts",
    "test:fdroid": "bun test ./tests/fdroid-recipe.test.ts",
    "hooks:install": "sh .githooks/pre-commit --install",
    "duplicates:check": "jscpd --config .jscpd.json --threshold 0 --fail-on-empty .",
    "duplicates:staged": "lint-staged --hide-all --config lint-staged.config.mjs",
    "test:hooks": "bun test ./tests/pre-commit.test.ts",
    "test:ci": "bun test ./tests/android-diagnostics.test.ts ./tests/ios-workspace-metadata.test.ts ./tests/android-ssh.test.ts ./tests/android-qr.test.ts ./tests/android-qr-ownership.test.ts ./tests/android-qr-frame.test.ts ./tests/herdr-source.test.ts",
    "dev": "turbo run dev:native --filter=@lazysh/client",
    "build": "turbo run build",
    "build:native": "turbo run build:native --filter=@lazysh/client",
    "build:android": "turbo run build:android --filter=@lazysh/client",
    "build:android:emulator": "turbo run build:android:emulator --filter=@lazysh/client",
    "test:android": "turbo run test:android --filter=@lazysh/client",
    "test:android-mosh": "turbo run test:android-mosh --filter=@lazysh/mosh-transport",
    "test:ios-mosh": "turbo run test:ios-mosh --filter=@lazysh/mosh-transport",
    "check": "turbo run check check:rust",
    "test": "turbo run test test:rust",
    "test:e2e": "turbo run test:e2e",
    "test:openssh": "turbo run test:openssh",
    "test:multiplexers": "turbo run test:multiplexers",
    "test:voice": "turbo run test:voice",
    "test:et": "turbo run test:et",
    "test:mosh": "turbo run test:mosh",
    "test:storage": "turbo run test:storage --filter=@lazysh/agent",
    "lint": "turbo run lint",
    "format:check": "turbo run format:check",
    "build:ios": "turbo run build:ios --filter=@lazysh/client",
    "test:install-browser": "turbo run test:install-browser",
    "test:ios-workspace": "turbo run test:ios-workspace --filter=@lazysh/client",
    "test:android-theme-links": "turbo run test:android-theme-links --filter=@lazysh/client",
    "test:android-ssh": "turbo run test:android-ssh --filter=@lazysh/client",
    "build:android:fdroid": "turbo run build:android:fdroid --filter=@lazysh/client",
    "test:android-fdroid": "turbo run test:android-fdroid --filter=@lazysh/client",
    "test:android-qr": "turbo run test:android-qr --filter=@lazysh/client"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "jscpd": "5.4.2",
    "lint-staged": "17.6.0",
    "turbo": "^2.11.10"
  },
  "license": "GPL-3.0-or-later"
}
