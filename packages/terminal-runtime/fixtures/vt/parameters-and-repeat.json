          "myz",
          ""
        ],
        "cursor": {
          "x": 1,
          "y": 4
        }
      }
    }
  },
  {
    "id": "tab-clear-parameter",
    "about": "TBC with an explicit 0 clears the stop at the cursor in both engines; without a parameter (CSI g, the usual spelling) it clears it in xterm.js and is ignored by libghostty-vt; CSI 3 g clears them all",
