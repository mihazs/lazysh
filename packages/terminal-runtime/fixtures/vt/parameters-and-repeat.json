    "rows": 6,
    "scrollback": 50,
    "steps": [
      {
        "write": "\t\u001b[0g\r\tx\r\n\t\u001b[g\r\tx\r\n\u001b[1;17H\u001b[g\r\u001b[2Iy\r\n\u001b[3g\r\tz"
