[
  {
    "id": "grow-columns",
    "about": "a wider terminal keeps rows and the cursor",
    "cols": 10,
    "rows": 4,
    "scrollback": 100,
    "steps": [
      {
        "write": "abcdefghij\r\nsecond"
      },
      {
        "resize": [
          20,
          4
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "abcdefghij",
        "second",
        "",
        ""
      ],
      "cursor": {
        "x": 6,
        "y": 1
      }
    }
  },
  {
    "id": "shrink-columns-reflows-wrapped-lines",
    "about": "a wrapped line is re-wrapped at the new width",
    "cols": 20,
    "rows": 5,
    "scrollback": 100,
    "steps": [
      {
        "write": "abcdefghijklmnopqrst\r\nshort"
      },
      {
        "resize": [
          8,
          5
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "abcdefgh",
        "ijklmnop",
        "qrst",
        "short",
        ""
      ],
      "cursor": {
        "x": 5,
        "y": 3
      }
    }
  },
  {
    "id": "shrink-rows-pushes-rows-into-history",
    "about": "fewer rows move the top rows into scrollback",
    "cols": 10,
    "rows": 5,
    "scrollback": 100,
    "steps": [
      {
        "write": "1\r\n2\r\n3\r\n4\r\n5"
      },
      {
        "resize": [
          10,
          3
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "3",
        "4",
        "5"
      ],
      "cursor": {
        "x": 1,
        "y": 2
      },
      "scrollbackRows": 2
    }
  },
  {
    "id": "grow-rows-pulls-history-back",
    "about": "more rows pull scrollback into view",
    "cols": 10,
    "rows": 3,
    "scrollback": 100,
    "steps": [
      {
        "write": "1\r\n2\r\n3\r\n4\r\n5\r\n6\r\n7\r\n8"
      },
      {
        "resize": [
          10,
          6
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ],
      "cursor": {
        "x": 1,
        "y": 5
      },
      "scrollbackRows": 2
    }
  },
  {
    "id": "resize-in-the-alternate-screen",
    "about": "the alternate screen resizes without reflow or history",
    "cols": 20,
    "rows": 3,
    "scrollback": 100,
    "steps": [
      {
        "write": "x\u001b[?1049h\u001b[HALTERNATE-SCREEN-TEXT"
      },
      {
        "resize": [
          8,
          4
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "ALTERNAT",
        "T",
        "",
        ""
      ],
      "cursor": {
        "x": 1,
        "y": 1
      },
      "buffer": "alternate"
    }
  },
  {
    "id": "narrower-with-the-cursor-past-the-new-width",
    "about": "The cursor sits in column 16 of a 20-column screen that shrinks to 15 columns: xterm.js clamps it to the last column; the core wraps the cursor onto a new row and pushes the rows below down",
    "cols": 20,
    "rows": 8,
    "scrollback": 100,
    "steps": [
      {
        "write": "x\r\nZ日本\r\n\u001b[1;16H"
      },
      {
        "resize": [
          15,
          8
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "x",
        "Z日本",
        "",
        "",
        "",
        "",
        "",
        ""
      ],
      "cursor": {
        "x": 14,
        "y": 0
      }
    },
    "core": {
      "divergence": [
        "resize-reflow"
      ],
      "expect": {
        "lines": [
          "x",
          "",
          "Z日本",
          "",
          "",
          "",
          "",
          ""
        ],
        "cursor": {
          "x": 0,
          "y": 1
        }
      }
    }
  },
  {
    "id": "narrower-with-an-unwrapped-long-line",
    "about": "A line longer than the new width that was ended with CR LF rather than wrapped: xterm.js cuts it at the new width, the core reflows the rest onto a new row (also true of a prompt line that fits before the resize)",
    "cols": 20,
    "rows": 4,
    "scrollback": 100,
    "steps": [
      {
        "write": "日本\r\né\r\nthe quick brown fox"
      },
      {
        "resize": [
          15,
          4
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "日本",
        "é",
        "the quick brown",
        ""
      ],
      "cursor": {
        "x": 14,
        "y": 2
      }
    },
    "core": {
      "divergence": [
        "resize-reflow"
      ],
      "expect": {
        "lines": [
          "日本",
          "é",
          "the quick brown",
          " fox"
        ],
        "cursor": {
          "x": 4,
          "y": 3
        }
      }
    }
  },
  {
    "id": "wider-after-an-autowrap",
    "about": "Text that autowrapped at 20 columns and the screen then grows to 30: the core joins the continuation row back onto its line, xterm.js keeps the break",
    "cols": 20,
    "rows": 5,
    "scrollback": 100,
    "steps": [
      {
        "write": "the quick brown foxx Z "
      },
      {
        "resize": [
          30,
          5
        ]
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "the quick brown foxx",
        " Z",
        "",
        "",
        ""
      ],
      "cursor": {
        "x": 3,
        "y": 1
      }
    },
    "core": {
      "divergence": [
        "resize-reflow"
      ],
      "expect": {
        "lines": [
          "the quick brown foxx Z",
          "",
          "",
          "",
          ""
        ],
        "cursor": {
          "x": 23,
          "y": 0
        }
      }
    }
  }
]
