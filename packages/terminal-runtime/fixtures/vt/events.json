[
  {
    "id": "osc52-clipboard-set",
    "about": "OSC 52 with BEL and ST terminators",
    "cols": 20,
    "rows": 3,
    "scrollback": 100,
    "steps": [
      {
        "write": "\u001b]52;c;SGVsbG8=\u001b\\"
      },
      {
        "write": "\u001b]52;p;V29ybGQ=\u0007"
      }
    ],
    "probes": [],
    "expect": {
      "lines": [
        "",
        "",
        ""
      ],
      "cursor": {
        "x": 0,
        "y": 0
      },
      "events": {
        "osc52": [
          "c;SGVsbG8=",
          "p;V29ybGQ="
        ]
      }
    },
    "core": {
      "divergence": [
        "osc52-payload-decoded",
        "osc52-selection-filter"
      ],
      "expect": {
        "events": {
          "bell": 0,
          "osc52": [
            "Hello"
          ]
        }
      }
    }
  },
  {
    "id": "osc52-selection-sets",
    "about": "OSC 52 with no selection, c, cp, pc, s and ps: the core keeps the writes that name no selection or only the clipboard",
