{
  "name": "@lazysh/mosh-transport",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "check:rust": "cargo check --manifest-path Cargo.toml --locked",
    "test:rust": "cargo test --manifest-path Cargo.toml --locked",
    "test:mosh": "cargo test --manifest-path Cargo.toml --test official_server --locked official_server_utf8_input_resize_shutdown_and_parallel_isolation -- --ignored",
    "test:android-mosh": "cargo test --manifest-path Cargo.toml --test official_server --locked android_emulator_official_server_interoperability -- --ignored",
    "test:ios-mosh": "cargo test --manifest-path Cargo.toml --test official_server --locked ios_simulator_official_server_interoperability -- --ignored --show-output",
    "lint": "cargo clippy --manifest-path Cargo.toml --locked --all-targets -- -D warnings",
    "format:check": "cargo fmt --manifest-path Cargo.toml -- --check"
  },
  "license": "GPL-3.0-or-later"
}
