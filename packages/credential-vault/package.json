{
  "name": "@lazysh/credential-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:rust": "cargo check --manifest-path Cargo.toml --locked",
    "test:rust": "cargo test --manifest-path Cargo.toml --locked",
    "lint": "cargo clippy --manifest-path Cargo.toml --locked --all-targets -- -D warnings",
    "format:check": "cargo fmt --manifest-path Cargo.toml -- --check",
    "test:resume": "xcodebuild -project ../../apps/client/src-tauri/gen/apple/lazysh.xcodeproj -scheme LazyshResumeTests -destination \"platform=iOS Simulator,id=$APPLE_STATUS_SIMULATOR_ID\" -resultBundlePath ../../apps/client/src-tauri/gen/apple/resume-tests.xcresult test CODE_SIGNING_ALLOWED=NO"
  },
