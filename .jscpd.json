{
  "minTokens": 50,
  "minLines": 5,
  "mode": "mild",
  "maxSize": "1mb",
  "reporters": [
    "console"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "packages/mosh-transport/vendor/**",
    "packages/mosh-transport/vendor-android/**",
    "packages/portable-pty-vendor/**",
    "bun.lock",
    "Cargo.lock",
    "packages/parakeet-runtime/licenses/**",
    "packages/deep-link-vendor/tests/xdg_commands.rs",
    "packages/deep-link-vendor/tests/xdg_unregister.rs"
  ]
}
