{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["PKG_CONFIG_PATH", "PKG_CONFIG_LIBDIR", "PKG_CONFIG_SYSROOT_DIR", "PROTOC"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "check": { "dependsOn": ["^check"] },
    "test": { "dependsOn": ["^build"] },
    "lint": { "cache": false },
    "format:check": { "cache": false },
    "check:rust": { "cache": false },
    "test:rust": { "cache": false },
    "test:resume-policy": { "cache": false },
    "test:storage": { "cache": false },
    "test:openssh": { "cache": false, "passThroughEnv": ["USER"] },
    "test:local": { "cache": false, "passThroughEnv": ["HOME", "USERPROFILE", "SHELL", "ComSpec", "COMSPEC", "SystemRoot", "SYSTEMROOT", "WINDIR"] },
    "test:multiplexers": { "cache": false, "passThroughEnv": ["PATH"] },
    "test:tmux": { "cache": false, "passThroughEnv": ["USER", "LAZYSH_TEST_TMUX"] },
    "test:voice": { "cache": false, "passThroughEnv": ["LAZYSH_WHISPER_TEST_MODEL", "LAZYSH_WHISPER_TEST_WAV"] },
    "test:mosh": { "cache": false, "passThroughEnv": ["USER"] },
    "test:android-mosh": { "cache": false, "passThroughEnv": ["USER", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME", "LAZYSH_ANDROID_ADB", "LAZYSH_ANDROID_TEST_BINARY", "LAZYSH_ANDROID_CXX_RUNTIME", "LAZYSH_ANDROID_UNIT_BINARY"] },
    "test:ios-workspace": { "cache": false, "passThroughEnv": ["DEVELOPER_DIR", "SDKROOT", "APPLE_STATUS_SIMULATOR_ID"] },
    "test:ios-mosh": { "cache": false, "passThroughEnv": ["USER", "DEVELOPER_DIR", "APPLE_STATUS_SIMULATOR_ID"] },
    "test:et": { "cache": false, "passThroughEnv": ["USER", "ET_SERVER_BIN", "ET_TERMINAL_BIN"] },
    "test:e2e": { "cache": false },
    "check:native-gui": {},
    "test:native-gui": { "cache": false, "dependsOn": ["build:native", "check:native-gui"], "passThroughEnv": ["LAZYSH_NATIVE_GUI_DRIVER", "LAZYSH_NATIVE_GUI_WEBKIT_DRIVER", "LAZYSH_NATIVE_GUI_XVFB", "LAZYSH_NATIVE_GUI_SECRET_SERVICE", "LAZYSH_NATIVE_MOSH_SERVER", "LAZYSH_TEST_HERDR", "LAZYSH_TEST_AGENT_BIN", "LAZYSH_TEST_RECEIVER_BIN"] },
    "test:install-browser": { "cache": false },
    "dev": { "cache": false, "persistent": true },
    "dev:native": { "cache": false, "persistent": true, "passThroughEnv": ["DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "XDG_SESSION_TYPE"] },
    "build:native": { "cache": false },
    "build:android": { "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "NDK_HOME", "ANDROID_NDK_HOME"] },
    "build:android:emulator": { "cache": false, "env": ["VITE_LAZYSH_QR_CAMERA_TRACE"], "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "NDK_HOME", "ANDROID_NDK_HOME"] },
    "build:android:fdroid": { "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "NDK_HOME", "ANDROID_NDK_HOME"] },
    "build:android:fdroid:emulator": { "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "NDK_HOME", "ANDROID_NDK_HOME"] },
    "test:android-push-artifact": { "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "LAZYSH_ANDROID_PUSH_VARIANT", "LAZYSH_ANDROID_PUSH_APK", "LAZYSH_ANDROID_PUSH_CONFIGURATION"] },
    "test:android-fdroid": { "dependsOn": ["build:android:fdroid:emulator"], "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME"] },
    "test:android-ntfy": { "dependsOn": ["build:android:fdroid:emulator"], "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME", "LAZYSH_ANDROID_QR_EMULATOR_PID_FILE"] },
    "test:android-theme-links": { "dependsOn": ["build:android:emulator"], "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME"] },
    "test:android-ssh": { "dependsOn": ["test:android"], "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME", "USER", "LAZYSH_NATIVE_MOSH_SERVER", "LAZYSH_ANDROID_UI_COMPANION", "GITHUB_ACTIONS", "RUNNER_ENVIRONMENT", "LAZYSH_ANDROID_UI_HERDR", "LAZYSH_TEST_HERDR", "LAZYSH_TEST_AGENT_BIN", "LAZYSH_TEST_RECEIVER_BIN"] },
    "test:android-herdr-navigation": {"dependsOn": ["build:android:emulator"], "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME", "USER", "GITHUB_ACTIONS", "RUNNER_ENVIRONMENT", "LAZYSH_TEST_HERDR", "LAZYSH_TEST_AGENT_BIN", "LAZYSH_TEST_RECEIVER_BIN"]},
    "test:android-qr": { "dependsOn": ["build:android:emulator"], "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME", "LAZYSH_ANDROID_QR_EMULATOR_PID_FILE"] },
    "test:android": { "dependsOn": ["test:android-theme-links"], "cache": false, "passThroughEnv": ["JAVA_HOME", "ANDROID_HOME", "ANDROID_SERIAL", "NDK_HOME", "ANDROID_NDK_HOME"] },
    "init:ios": { "cache": false, "passThroughEnv": ["DEVELOPER_DIR", "SDKROOT"] },
    "build:ios": { "dependsOn": ["init:ios"], "cache": false, "passThroughEnv": ["DEVELOPER_DIR", "SDKROOT"] }
  }
}
